configfile: "config/config.yaml"

# The BIDS names are the subject list: {subject} is read from the files themselves.
BIDS = "data/raw/{subject}/eeg/{subject}_task-{task}_events.tsv"
SUBJECTS = sorted(set(glob_wildcards(BIDS).subject))
TASK = config["task"]


rule all:
    input:
        "derivatives/group/behavior_summary.tsv",
        "derivatives/group/behavior_summary.png",


rule summarize:  # participant level: one job per subject
    input:
        BIDS,
    output:
        "derivatives/behavior/{subject}/{subject}_task-{task}_summary.tsv",
    script:
        "code/summarize.py"


rule group:  # group level: every participant → one table + one figure
    input:
        expand(
            "derivatives/behavior/{subject}/{subject}_task-{task}_summary.tsv",
            subject=SUBJECTS,
            task=TASK,
        ),
    output:
        tsv="derivatives/group/behavior_summary.tsv",
        png="derivatives/group/behavior_summary.png",
    script:
        "code/group.py"
